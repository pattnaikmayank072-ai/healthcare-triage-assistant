# Copy to a private .env file; never commit populated secrets.
JWT_SIGNING_SECRET=
DATA_ENCRYPTION_KEY=
TRIAGE_DATABASE_PATH=triage_assistant.sqlite3
ALLOW_EXTERNAL_LLM=false
MOCK_LLM=true
SYNTHETIC_AUDIO_ALLOWED=false
API_RATE_LIMIT=60/minute
LOGIN_RATE_LIMIT=5/minute
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
SARVAM_API_KEY=
HF_TOKEN=
# Configure only after local model files and approved language gazetteer are present.
FASTER_WHISPER_MODEL_PATH=
INDICTRANS2_MODEL_PATH=
MAX_LLM_CALLS_PER_CASE=8
MAX_LLM_INPUT_CHARS=12000
MAX_LLM_OUTPUT_TOKENS=700
MAX_REQUEST_BYTES=6291456
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_PAGES=5
# Leave blank until a retention duration has been approved.
RETENTION_DAYS=
# Comma-separated approved browser origins; blank disables CORS.
ALLOWED_ORIGINS=
# APScheduler watchdog is opt-in at deployment; requires both secrets above.
BACKGROUND_SCHEDULER_ENABLED=false
WATCHDOG_INTERVAL_SECONDS=60
